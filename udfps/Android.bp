cc_library {
    name: "libudfpshandler",
    vendor: true,
    cflags: ["-D_HAS_QSEE", "-D_NEEDS_INI_RELOCATION"],
    srcs: ["UdfpsHandler.cpp"],
    shared_libs: [
        "libbase",
    ],
    header_libs: [
        "//hardware/egistec/fingerprint:egistecfingerprint_headers",
    ],
}
